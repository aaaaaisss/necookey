<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 以降の自動バックアップと機種変更時の転送。リランカー表（sumire_lm、約56MB）は
     アセットから復元できるので外す（上限 25MB を超えるとユーザー辞書もバックアップされなくなる）。 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="sumire_lm/"/>
        <exclude domain="external" path="sumire_lm/"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="sumire_lm/"/>
        <exclude domain="external" path="sumire_lm/"/>
    </device-transfer>
</data-extraction-rules>
