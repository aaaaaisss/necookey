<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 以前の自動バックアップ。リランカー表（sumire_lm、約56MB）はアセットから復元できるので外す。
     入れると上限 25MB を超えてアプリ全体のバックアップが止まる（ユーザー辞書も保存されなくなる）。 -->
<full-backup-content>
    <exclude domain="file" path="sumire_lm/"/>
    <exclude domain="external" path="sumire_lm/"/>
</full-backup-content>
