<?xml version="1.0" encoding="utf-8"?>
<androidx.preference.PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory android:title="@string/necookey_candidate_bar_category_title">
        <SwitchPreferenceCompat
            android:key="necookey_two_row_candidate_bar_preference"
            android:title="@string/necookey_two_row_candidate_bar_title"
            app:defaultValue="true"
            app:summary="@string/necookey_two_row_candidate_bar_summary" />

        <SwitchPreferenceCompat
            android:dependency="necookey_two_row_candidate_bar_preference"
            android:key="necookey_zenz_bunsetsu_gate_preference"
            android:title="@string/necookey_zenz_bunsetsu_gate_title"
            app:defaultValue="true"
            app:summary="@string/necookey_zenz_bunsetsu_gate_summary" />

        <Preference
            android:key="zenz_diagnostics_preference"
            android:title="@string/zenz_diagnostics_title"
            app:summary="@string/zenz_diagnostics_entry_summary" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/zenz_preference_category_title">

        <SwitchPreferenceCompat
            android:key="enable_zenz_rerank_preference"
            android:title="@string/enable_zenz_rerank_preference_title"
            app:defaultValue="false"
            app:summary="@string/enable_zenz_rerank_preference_summary" />

        <Preference
            android:key="zenz_model_select_preference"
            android:title="モデルの読み込み元"
            app:summary="デフォルト（Assets）" />

        <SwitchPreferenceCompat
            android:key="enable_zenz_right_context_preference"
            android:title="@string/enable_zenz_right_context_preference_title"
            app:defaultValue="false"
            app:summary="@string/enable_zenz_right_context_preference_summary" />

        <SeekBarPreference
            android:defaultValue="32"
            android:key="zenz_maximum_letter_count_preference"
            android:max="128"
            android:title="@string/zenz_maximum_letter_count_preference_title"
            app:min="32"
            app:seekBarIncrement="5"
            app:showSeekBarValue="true"
            app:summary="@string/zenz_maximum_letter_count_preference_summary" />

        <SeekBarPreference
            android:defaultValue="512"
            android:key="zenz_maximum_context_count_preference"
            android:max="1024"
            android:title="@string/zenz_maximum_context_count_preference_title"
            app:min="256"
            app:seekBarIncrement="10"
            app:showSeekBarValue="true"
            app:summary="@string/zenz_maximum_context_count_preference_summary" />

        <SeekBarPreference
            android:defaultValue="4"
            android:key="zenz_maximum_thread_count_preference"
            android:max="8"
            android:title="@string/zenz_maximum_thread_count_preference_title"
            app:min="1"
            app:seekBarIncrement="1"
            app:showSeekBarValue="true"
            app:summary="@string/zenz_maximum_thread_count_preference_summary" />
    </PreferenceCategory>

</androidx.preference.PreferenceScreen>
