<?xml version="1.0" encoding="utf-8"?>
<!-- 学習辞書: 検索欄＋読みごとの角丸カード一覧。操作（読み込み・書き出し・すべて削除）は上部バーのメニュー。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/text_input_layout_search_learn_dictionary"
            style="@style/Widget.Necookey.SearchField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/settings_screen_padding_h"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="@dimen/settings_screen_padding_h">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edit_text_search_learn_dictionary"
                style="@style/Widget.Necookey.SearchField.EditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/st_search" />
        </com.google.android.material.textfield.TextInputLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/learn_dictionary_recycler_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="@dimen/settings_list_bottom"
                android:scrollbars="none"
                tools:listitem="@layout/learn_dictionary_item" />

            <include
                android:id="@+id/empty_state"
                layout="@layout/settings_empty_state" />

            <com.kazumaproject.markdownhelperkeyboard.setting_activity.ui.common.RecyclerViewFastScroller
                android:id="@+id/learn_dictionary_fast_scroller"
                android:layout_width="32dp"
                android:layout_height="match_parent"
                android:layout_gravity="end" />
        </FrameLayout>
    </LinearLayout>

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/progress_bar_learn_dictionary_fragment"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminate="true"
        android:visibility="invisible"
        app:indicatorColor="?attr/colorPrimary" />

</FrameLayout>
