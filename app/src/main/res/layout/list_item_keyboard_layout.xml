<?xml version="1.0" encoding="utf-8"?>
<!-- 配列一覧の 1 行: 名前＋作成日、右に並べ替えのつまみとメニュー。背景は SettingsListCards。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="false"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="@dimen/settings_home_row_min_height"
    android:orientation="horizontal"
    android:paddingStart="@dimen/settings_row_padding_h"
    android:paddingTop="12dp"
    android:paddingEnd="4dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/keyboard_name_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAppearance="@style/TextAppearance.Necookey.RowTitle"
            tools:text="プログラム用キーボード" />

        <TextView
            android:id="@+id/keyboard_date_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="@style/TextAppearance.Necookey.RowSummary"
            tools:text="作成日: 2026/10/31" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/drag_handle_button"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/drag_item"
        android:scaleType="center"
        app:srcCompat="@drawable/ic_ms_drag_indicator"
        app:tint="?attr/colorOnSurfaceVariant" />

    <ImageButton
        android:id="@+id/keyboard_menu_button"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/desc_layout_options"
        android:scaleType="center"
        app:srcCompat="@drawable/ic_ms_more_vert"
        app:tint="?attr/colorOnSurfaceVariant" />
</LinearLayout>
