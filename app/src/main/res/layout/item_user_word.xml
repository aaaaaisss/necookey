<?xml version="1.0" encoding="utf-8"?>
<!-- ユーザー辞書の 1 行（単語＋読み）。背景（角丸カード）は SettingsListCards がコードで付ける。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="@dimen/settings_row_min_height"
    android:orientation="vertical"
    android:paddingStart="@dimen/settings_row_padding_h"
    android:paddingTop="12dp"
    android:paddingEnd="@dimen/settings_row_padding_h"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/text_view_word"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:textAppearance="@style/TextAppearance.Necookey.RowTitle"
        tools:text="お疲れ様です。" />

    <TextView
        android:id="@+id/text_view_reading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.Necookey.RowSummary"
        tools:text="おつかれさまです" />
</LinearLayout>
