<?xml version="1.0" encoding="utf-8"?>
<!-- ユーザー辞書: 単語を編集（単語・読み・品詞・スコア）。 -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/settings_dialog_padding_h"
        android:paddingTop="8dp"
        android:paddingEnd="@dimen/settings_dialog_padding_h">

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Necookey.DialogField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/st_field_word">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edit_text_word_dialog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Necookey.DialogField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/st_field_reading">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edit_text_reading_dialog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Necookey.DialogDropdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/st_field_pos">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/spinner_pos_dialog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Necookey.DialogField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/st_field_score">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edit_text_pos_score_dialog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number" />
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
