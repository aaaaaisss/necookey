<?xml version="1.0" encoding="utf-8"?>
<!-- スライダーの行（SeekBarPreference が使う id: seekbar / seekbar_value）。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/settings_row_min_height"
    android:orientation="vertical"
    android:paddingStart="@dimen/settings_row_padding_h"
    android:paddingTop="@dimen/settings_row_padding_v"
    android:paddingEnd="@dimen/settings_row_padding_h"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="true"
        android:orientation="horizontal">

        <TextView
            android:id="@android:id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAppearance="@style/TextAppearance.Necookey.RowTitle" />

        <TextView
            android:id="@id/seekbar_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:textAppearance="@style/TextAppearance.Necookey.Value" />
    </LinearLayout>

    <TextView
        android:id="@android:id/summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textAppearance="@style/TextAppearance.Necookey.RowSummary" />

    <SeekBar
        android:id="@id/seekbar"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="@null"
        android:paddingStart="0dp"
        android:paddingEnd="0dp"
        android:progressTint="?attr/colorPrimary"
        android:progressBackgroundTint="?attr/colorSurfaceContainerHighest"
        android:thumbTint="?attr/colorPrimary" />
</LinearLayout>
