<?xml version="1.0" encoding="utf-8"?>
<!-- 確定後にカーソルを戻す記号 の 1 行: 記号を大きく＋右に削除ボタン（タップで編集）。背景は SettingsListCards。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="@dimen/settings_row_min_height"
    android:orientation="horizontal"
    android:paddingStart="@dimen/settings_row_padding_h"
    android:paddingEnd="4dp">

    <TextView
        android:id="@+id/pair_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textAppearance="@style/TextAppearance.Necookey.Glyph"
        tools:text="「」" />

    <ImageButton
        android:id="@+id/delete_icon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/st_delete"
        android:scaleType="center"
        app:srcCompat="@drawable/ic_ms_close"
        app:tint="?attr/colorOnSurfaceVariant" />
</LinearLayout>
