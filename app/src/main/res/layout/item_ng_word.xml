<?xml version="1.0" encoding="utf-8"?>
<!-- NG ワードの 1 行: 単語＋読み、右に照合方式。背景は SettingsListCards。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="false"
    android:gravity="center_vertical"
    android:minHeight="@dimen/settings_row_min_height"
    android:orientation="horizontal"
    android:paddingStart="@dimen/settings_row_padding_h"
    android:paddingTop="12dp"
    android:paddingEnd="@dimen/settings_row_padding_h"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/text_view_tango"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAppearance="@style/TextAppearance.Necookey.RowTitle"
            tools:text="単語" />

        <TextView
            android:id="@+id/text_view_yomi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Necookey.RowSummary"
            tools:text="たんご" />
    </LinearLayout>

    <TextView
        android:id="@+id/text_view_match_mode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:textAppearance="@style/TextAppearance.Necookey.Value"
        tools:text="部分一致" />
</LinearLayout>
