<?xml version="1.0" encoding="utf-8"?>
<!-- 確定後にカーソルを戻す記号: 短い説明＋角丸カード一覧＋追加の FAB。「初期値に戻す」は上部バーのメニュー。 -->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".cursor_move_targets.ui.CursorMoveTargetPairsFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <TextView
            android:id="@+id/cursor_move_target_pairs_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="32dp"
            android:text="@string/st_cursor_pairs_caption"
            android:textAppearance="@style/TextAppearance.Necookey.Caption" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/cursor_move_target_pairs_recycler_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/settings_list_bottom_fab"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
    </LinearLayout>

    <include
        android:id="@+id/empty_state"
        layout="@layout/settings_empty_state" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/add_cursor_move_target_pair_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/settings_fab_margin"
        android:contentDescription="@string/st_cursor_pair_add"
        app:srcCompat="@drawable/ic_ms_add" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
