<?xml version="1.0" encoding="utf-8"?>
<!-- 設定のグループ見出し。カードの中の文字と同じ左端にそろえる（カードの左 16dp ＋ 行の 16dp は装飾側で持つ）。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/settings_row_padding_h"
    android:paddingTop="24dp"
    android:paddingEnd="@dimen/settings_row_padding_h"
    android:paddingBottom="8dp">

    <TextView
        android:id="@android:id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.Necookey.SectionLabel" />

    <TextView
        android:id="@android:id/summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.Necookey.RowSummary"
        android:visibility="gone" />
</LinearLayout>
